movie = input("\nEnter movie code (m1/m2/m3): ").lower()
number_tickets = int(input("Enter numbers of ticket: "))
customer_type = input("Enter customer type (senior/regular): ").upper()
payment = int(input("Enter payment amount: "))

if movie == "m1":
    name = "The conjuring: Last Rites"
    price = 350

elif movie == "m2":
    name = "Weapons"
    price = 320

elif movie == "m3":
    name = " Demon Slayer: Kimetsu no Yaiba - Infinity Castle"
    price = 650

else:
    print("Invalid")
    exit()

total_price = price * number_tickets


if customer_type == "SENIOR" and number_tickets <= 3:
    discount = total_price * 0.15
elif  customer_type == "SENIOR" and number_tickets >= 4:
    discount = total_price * 0.30

elif customer_type == "REGULAR":
    discount = 0

totaldc = total_price - discount
change = payment - totaldc

